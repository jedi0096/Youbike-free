# Demo 金鑰只包含在作業提交的壓縮檔案中，並不包含在公開 Github 上

# Google Maps Platform 金鑰 —— 用於以真實道路距離校正騎乘時間
# 需啟用 Distance Matrix API / Directions API
GOOGLE_MAPS_API_KEY=YOUR_KEY

# Google Gemini 金鑰 —— AI 回饋語氣潤飾（客觀事實 → LLM 潤飾）
# 申請：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_KEY
# 便宜快速且仍在服務中的模型（gemini-1.5-* 與 2.0-* 已退役，勿用）
GEMINI_MODEL=gemini-2.5-flash

# ---- 以下為自己架設（Docker）時的選用設定，不填則使用預設值。說明見 DEPLOY.md ----

# 容器的記憶體上限。超過時 Docker 會強制重啟 App，避免拖垮整台電腦。
# 8 GB 的電腦用預設的 3g；16 GB 以上可設 6g。
# APP_MEM_LIMIT=3g

# 建新站點圖之前，離記憶體上限若不到這麼多 MB，就先把舊圖清掉再建（0 = 停用）。
# 一張圖依側欄設定約 0.4~2 GB，預設值留的是最大那種圖的空間。
# GRAPH_BUILD_HEADROOM_MB=2048

# 最多同時保留幾張站點圖（每種側欄設定組合一張）。記憶體充裕時可調大，例如 4。
# GRAPH_CACHE_MAX_ENTRIES=2

# 站點圖多久重建一次（秒）。數字越小車況越即時，但越常需要等待重建。
# GRAPH_CACHE_TTL_SECONDS=600

# App 的連接埠，以及開放給誰連線：
# 127.0.0.1 = 只有這台電腦；0.0.0.0 = 同一個網路的其他裝置也連得到。
# APP_PORT=8501
# APP_BIND=127.0.0.1

# 對外公開網址（Cloudflare Tunnel）。public = 臨時網址；public-fixed = 固定網址，
# 需要再填 TUNNEL_TOKEN（Cloudflare 控制台建立 tunnel 時給的金鑰）。
# COMPOSE_PROFILES=public
# TUNNEL_TOKEN=
